# 이 파일을 .env.local 로 복사한 뒤 실제 키를 넣으세요. (.env.local 은 .gitignore 에 있습니다)
# 주의: VITE_ 접두사를 붙이면 클라이언트 번들에 그대로 박혀 유출됩니다. 절대 붙이지 마세요.
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 사용할 모델 (기본값 claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 선택: 서버측 호출 제한 (IP 당)
# READ_RATE_LIMIT=20          # 창(window) 당 최대 호출 수
# READ_RATE_WINDOW_MS=600000  # 창 길이 (ms)
