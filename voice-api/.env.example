# 이 파일을 .env.local 로 복사한 뒤 실제 값을 넣으세요. (.env.local 은 .gitignore 에 있습니다)

# ElevenLabs → Settings → API Keys
ELEVENLABS_API_KEY=sk_...

# npm run clone -- "내 목소리" samples/*.mp3 가 출력한 값
VOICE_ID=

# 이 API 를 부를 때 쓰는 비밀 토큰. 아무 긴 무작위 문자열이면 됩니다.
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
VOICE_API_TOKEN=

# 선택: 모델 (기본값 eleven_multilingual_v2 — 한국어·영어 자동 인식)
# ELEVENLABS_MODEL=eleven_flash_v2_5

# 선택: 한 번에 읽을 최대 글자 수, IP 당 호출 제한
# SPEAK_MAX_CHARS=1000
# SPEAK_RATE_LIMIT=30          # 창(window) 당 최대 호출 수
# SPEAK_RATE_WINDOW_MS=600000  # 창 길이 (ms)
